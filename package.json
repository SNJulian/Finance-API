{
  "name": "Finance-API",
  "version": "1.2.0",
  "description": "Sample Finance API for demonstrating GitHub CI/CD, SonarCloud analysis, and SBOM generation.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "jest --coverage"
  },
  "keywords": [
    "finance",
    "api",
    "express",
    "ci-cd",
    "sonarcloud",
    "demo"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "simple-statistics": "^7.8.8",
    "left-pad": "1.1.3",
    "lodash": "4.17.21"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports/junit",
          "outputName": "jest-results.xml",
          "classNameTemplate": "{classname}",
          "titleTemplate": "{title}",
          "ancestorSeparator": " › "
        }
      ]
    ], 
    "testEnvironment": "node"
  }
}
